# App Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql+asyncpg://postgres:Bindu%40134366@localhost:5432/crm_db

# JWT & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Business / Meta Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_API_VERSION=v20.0

# =========================
# EXOTEL
# =========================
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_REGION=Singapore

# ExoPhone / Indian virtual number
EXOTEL_EXOPHONE=+919876543210

# Webhook
EXOTEL_WEBHOOK_URL=https://your-domain.com/api/calls/webhook